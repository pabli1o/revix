# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NEVER expose these two client-side. They are read only in server Route
# Handlers / Server Components and must never be prefixed with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
ANTHROPIC_API_KEY=

# Whop (payments — subscription + one-time credit top-up)
WHOP_API_KEY=
# The endpoint's signing secret, exactly as Whop shows it (ws_...)
WHOP_WEBHOOK_SECRET=
# The subscription's plan (plan_...), created ahead of time in the Whop
# dashboard. The credit top-up doesn't need one — it uses an inline plan.
WHOP_PLAN_ID=
# Optional: only needed if the API key isn't already scoped to one account
WHOP_ACCOUNT_ID=

# Set to "true" to route every Whop call above (client, plan, webhook
# verification) to its "_SANDBOX" counterpart below instead, and to
# https://sandbox-api.whop.com/api/v1 instead of the production API — lets
# you test full checkouts with fake cards without touching real money or
# the production credentials. Flip back to "false" (or unset) for
# production — see lib/whop/client.ts.
WHOP_SANDBOX=false
WHOP_API_KEY_SANDBOX=
WHOP_WEBHOOK_SECRET_SANDBOX=
WHOP_PLAN_ID_SANDBOX=
WHOP_ACCOUNT_ID_SANDBOX=

# Base URL used to build absolute redirect/callback URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
