# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NEVER expose these two client-side. They are read only in server Route
# Handlers / Server Components and must never be prefixed with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
ANTHROPIC_API_KEY=

# Whop (payments — 3 recurring monthly plans + 1 one-time credit top-up,
# see lib/subscription/constants.ts)
WHOP_API_KEY=
# The endpoint's signing secret, exactly as Whop shows it (ws_...)
WHOP_WEBHOOK_SECRET=
# One recurring monthly plan (plan_...) per tier, created ahead of time in
# the Whop dashboard at the exact prices in lib/subscription/constants.ts
# (9,99 € / 19,99 € / 39,99 €).
WHOP_PLAN_ID_TIER1=
WHOP_PLAN_ID_TIER2=
WHOP_PLAN_ID_TIER3=
# One-time (non-recurring) plan for the +1500 crédits top-up (9,99 €,
# EXTRA_CREDIT_* in lib/subscription/constants.ts) — available to an active
# subscriber on any tier from /abonnement.
WHOP_CREDIT_PLAN_ID=
# Optional: only needed if the API key isn't already scoped to one account
WHOP_ACCOUNT_ID=

# Set to "true" to route every Whop call above (client, plans, webhook
# verification) to its "_SANDBOX" counterpart below instead, and to
# https://sandbox-api.whop.com/api/v1 instead of the production API — lets
# you test full checkouts with fake cards without touching real money or
# the production credentials. Flip back to "false" (or unset) for
# production — see lib/whop/client.ts.
WHOP_SANDBOX=false
WHOP_API_KEY_SANDBOX=
WHOP_WEBHOOK_SECRET_SANDBOX=
WHOP_PLAN_ID_TIER1_SANDBOX=
WHOP_PLAN_ID_TIER2_SANDBOX=
WHOP_PLAN_ID_TIER3_SANDBOX=
WHOP_CREDIT_PLAN_ID_SANDBOX=
WHOP_ACCOUNT_ID_SANDBOX=

# Base URL used to build absolute redirect/callback URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
