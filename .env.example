# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NEVER expose these two client-side. They are read only in server Route
# Handlers / Server Components and must never be prefixed with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
ANTHROPIC_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Base URL used to build absolute redirect/callback URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
